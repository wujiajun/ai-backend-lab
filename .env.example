APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=mysql+pymysql://root:change_me@127.0.0.1:3306/ai_backend_lab
TEST_DATABASE_URL=mysql+pymysql://root:change_me@127.0.0.1:3306/ai_backend_lab_test

RISK_SERVICE_BASE_URL=http://127.0.0.1:9001

RISK_CONNECT_TIMEOUT=2.0
RISK_READ_TIMEOUT=5.0
RISK_WRITE_TIMEOUT=5.0
RISK_POOL_TIMEOUT=2.0

RISK_RETRY_ATTEMPTS=3
RISK_RETRY_INITIAL_WAIT=0.2
RISK_RETRY_MAX_WAIT=2.0

OPENAI_API_KEY=change_me
LLM_MODEL=change_me
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_ATTEMPTS=2
LLM_RETRY_INITIAL_WAIT=0.5
LLM_RETRY_MAX_WAIT=4.0
AGENT_MAX_STEPS=6